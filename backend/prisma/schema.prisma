generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ConversationStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MessageSender {
  CLIENT
  ADMIN
  SYSTEM
}

enum MessageType {
  TEXT
  PHOTO
  VIDEO
  SYSTEM
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

model Admin {
  id           String   @id @default(uuid())
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
}

model Product {
  id               String   @id @default(uuid())
  name             String
  description      String
  category         String
  pricePerHour     Float
  mainPhotoUrl     String
  additionalPhotos String[] @default([])
  videoUrl         String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  conversations Conversation[]
  bookings      Booking[]
}

model Conversation {
  id             String             @id @default(uuid())
  sessionId      String
  clientPseudo   String
  clientAge      Int
  status         ConversationStatus @default(ACTIVE)
  lastActivityAt DateTime           @default(now())
  expiresAt      DateTime
  createdAt      DateTime           @default(now())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  messages Message[]
  bookings Booking[]

  @@index([sessionId])
  @@index([status])
}

model Message {
  id        String        @id @default(uuid())
  content   String?
  mediaUrl  String?
  sender    MessageSender
  type      MessageType   @default(TEXT)
  createdAt DateTime      @default(now())

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
}

// Une location/réservation : toujours créée et confirmée par l'admin,
// le plus souvent directement depuis une conversation (conversationId renseigné),
// mais peut aussi être créée manuellement (conversationId nul).
model Booking {
  id            String        @id @default(uuid())
  clientPseudo  String
  clientAge     Int
  clientContact String?
  date          DateTime
  startTime     String
  durationHours Float
  status        BookingStatus @default(PENDING)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  productId String
  product   Product @relation(fields: [productId], references: [id])

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])

  @@index([date])
  @@index([status])
}
